          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraînez d’abord le modèle"
          }
        }
      }
    },
    "Naucz model, co chcesz usuwać": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teach the model what you want to delete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring dem Modell bei, was du löschen willst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enseña al modelo qué quieres eliminar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprenez au modèle ce que vous voulez supprimer"
          }
        }
      }
    },
    "Oznacz zdjęcia jako Zachowaj / Usuń. Potrzeba co najmniej 20 z każdej kategorii.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark photos as Keep / Delete. At least 20 of each category are needed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere Fotos als Behalten / Löschen. Es braucht mindestens 20 pro Kategorie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca fotos como Conservar / Eliminar. Se necesitan al menos 20 de cada categoría."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez des photos comme Conserver / Supprimer. Il en faut au moins 20 de chaque catégorie."
          }
        }
      }
    },
    "Pokazuje filmy od największych. Możesz je obejrzeć, usunąć albo skompresować.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows videos from largest to smallest. You can watch, delete or compress them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Videos nach Größe sortiert. Du kannst sie ansehen, löschen oder komprimieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los vídeos de mayor a menor. Puedes verlos, eliminarlos o comprimirlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les vidéos de la plus grande à la plus petite. Vous pouvez les regarder, supprimer ou compresser."
          }
        }
      }
    },
    "Pokaż filmy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show videos"
          }
        },
        "de": {
