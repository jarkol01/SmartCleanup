{
  "sourceLanguage": "pl",
  "strings": {
    "Za mało oznaczonych zdjęć": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough labeled photos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu wenige markierte Fotos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de photos étiquetées"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficientes fotos etiquetadas"
          }
        }
      }
    },
    "Oznacz jeszcze kilka zdjęć w sekcji \"Ucz model\" na ekranie głównym — potrzeba co najmniej 3 z każdej kategorii.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label a few more photos in \"Train Model\" on the home screen — you need at least 3 in each category."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere noch ein paar Fotos im Bereich „Modell trainieren“ auf dem Startbildschirm — du brauchst mindestens 3 pro Kategorie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étiquetez encore quelques photos dans « Entraîner le modèle » sur l'écran d'accueil — il en faut au moins 3 par catégorie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiqueta unas cuantas fotos más en \"Entrenar modelo\" en la pantalla principal: necesitas al menos 3 de cada categoría."
          }
        }
      }
    },
    "Brak dostępu do zdjęć": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to photos"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Zugriff auf Fotos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun accès aux photos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin acceso a las fotos"
          }
        }
      }
    },
    "Włącz dostęp do zdjęć w Ustawieniach, aby korzystać z aplikacji.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable photo access in Settings to use the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Fotozugriff in den Einstellungen, um die App zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l'accès aux photos dans Réglages pour utiliser l'application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el acceso a las fotos en Ajustes para usar la aplicación."
          }
        }
      }
    },
    "Wszystko przejrzane": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All caught up"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles durchgesehen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est examiné"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo revisado"
          }
        }
      }
    },
    "Nie ma już nowych zdjęć do przejrzenia w tej bibliotece.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are no more new photos to review in this library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keine neuen Fotos mehr zum Überprüfen in dieser Mediathek."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a plus de nouvelles photos à examiner dans cette photothèque."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No quedan fotos nuevas por revisar en esta biblioteca."
          }
        }
      }
    },
