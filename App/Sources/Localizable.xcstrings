    "Znajduje serie niemal identycznych zdjęć zrobionych w krótkim odstępie, np. zdjęcia seryjne.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds series of nearly identical photos taken moments apart, such as bursts."
          }
        },
        "de": {
