    "Już skompresowane": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits komprimiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already compressed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya comprimido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà compressée"
          }
        }
      }
    },
    "Slow motion – pomijane": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitlupe – übersprungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow motion – skipped"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cámara lenta – omitido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ralenti – ignorée"
          }
        }
      }
    },
    "Tryb kinowy – pomijane": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinomodus – übersprungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinematic – skipped"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Cine – omitido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Cinématique – ignorée"
          }
        }
      }
    },
    "Już oszczędnie zapisane": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits platzsparend gespeichert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already efficiently encoded"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya guardado de forma eficiente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà encodée efficacement"
          }
        }
      }
    },
    "Skompresowane kopie zapisane: %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimierte Kopien gespeichert: %lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compressed copies saved: %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copias comprimidas guardadas: %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies compressées enregistrées : %lld"
          }
        }
      }
    },
    "Kopie są już w bibliotece. Teraz usuniemy oryginały, co zwolni ok. %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopien sind bereits in deiner Mediathek. Jetzt löschen wir die Originale und geben etwa %@ frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copies are already in your library. Next we'll delete the originals, freeing about %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias ya están en tu fototeca. Ahora eliminaremos los originales, lo que liberará unos %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies sont déjà dans votre photothèque. Nous allons maintenant supprimer les originaux, ce qui libérera environ %@."
          }
        }
      }
    },
    "Usuń oryginały": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete originals"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar originales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer les originaux"
          }
        }
      }
    },
    "Zostaw oryginały": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale behalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep originals"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar originales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les originaux"
          }
        }
      }
    },
    "**Cała grupa niepotrzebna?** Odznacz wszystkie i usuń ją w całości.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Don’t need the whole group?** Unmark all and delete it entirely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ganze Gruppe überflüssig?** Alle abwählen und komplett löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**¿No necesitas el grupo entero?** Desmarca todas y elimínalo por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tout le groupe est inutile ?** Décochez tout et supprimez-le entièrement."
          }
        }
      }
    },
    "**Co najmniej 20 z każdej kategorii.** Model douczy się przy następnym „Usuń zdjęcia”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**At least 20 of each category.** The model updates on your next “Delete Photos”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mindestens 20 pro Kategorie.** Das Modell lernt beim nächsten „Fotos löschen“ dazu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Al menos 20 de cada categoría.** El modelo se actualizará en el próximo «Eliminar fotos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Au moins 20 de chaque catégorie.** Le modèle se mettra à jour au prochain « Supprimer des photos »."
          }
        }
      }
    },
    "**Najpierw zapisujemy kopię.** O usunięciu oryginałów zdecydujesz potem.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**We save a copy first.** You decide about deleting the originals afterwards."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Zuerst speichern wir eine Kopie.** Über das Löschen der Originale entscheidest du danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Primero guardamos una copia.** Después decides si eliminar los originales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nous enregistrons d’abord une copie.** Vous déciderez ensuite de supprimer les originaux."
          }
        }
      }
    },
    "**Pasek** pod zdjęciem pokazuje pewność modelu. Niepewne przejrzysz osobno.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The **bar** under a photo shows the model’s confidence. You can review uncertain ones separately."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der **Balken** unter dem Foto zeigt, wie sicher das Modell ist. Unsichere prüfst du separat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La **barra** bajo la foto muestra la confianza del modelo. Las dudosas las revisas aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La **barre** sous la photo indique la confiance du modèle. Les incertaines se vérifient à part."
          }
        }
      }
    },
    "**Pasek** pokazuje, jak bardzo zdjęcie jest rozmyte. Próg zmienisz w Ustawieniach.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The **bar** shows how blurry a photo is. You can change the threshold in Settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der **Balken** zeigt, wie unscharf ein Foto ist. Den Schwellenwert änderst du in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La **barra** muestra lo borrosa que está la foto. Puedes cambiar el umbral en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La **barre** indique à quel point la photo est floue. Le seuil se règle dans les Réglages."
          }
        }
      }
    },
    "**Po jednej grupie.** Domyślnie zostaje zdjęcie o najwyższej rozdzielczości.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**One group at a time.** By default the highest-resolution photo is kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Eine Gruppe nach der anderen.** Standardmäßig bleibt das Foto mit der höchsten Auflösung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Un grupo cada vez.** Por defecto se conserva la foto de mayor resolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Un groupe à la fois.** Par défaut, la photo de plus haute résolution est conservée."
          }
        }
      }
    },
    "**Przeciągnij w lewo**, żeby usunąć.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Swipe left** to delete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nach links wischen**, um zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desliza a la izquierda** para eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Balayez vers la gauche** pour supprimer."
          }
        }
      }
    },
    "**Przeciągnij w prawo**, żeby zachować.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Swipe right** to keep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nach rechts wischen**, um zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Desliza a la derecha** para conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Balayez vers la droite** pour conserver."
          }
        }
      }
    },
    "**Przytrzymaj**, by powiększyć i obejrzeć szczegóły.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Press and hold** to zoom in and see details."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gedrückt halten**, um zu vergrößern und Details zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantén pulsado** para ampliar y ver detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maintenez appuyé** pour agrandir et voir les détails."
          }
        }
      }
    },
    "**Przytrzymaj**, by powiększyć i porównać szczegóły.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Press and hold** to zoom in and compare details."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gedrückt halten**, um zu vergrößern und Details zu vergleichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantén pulsado** para ampliar y comparar detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maintenez appuyé** pour agrandir et comparer les détails."
          }
        }
      }
    },
    "**Przytrzymaj**, by powiększyć lub oznaczyć wyjątek (np. zdjęcie licznika).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Press and hold** to zoom in or mark an exception (e.g. a meter reading photo)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Gedrückt halten**, um zu vergrößern oder eine Ausnahme zu markieren (z. B. Foto eines Zählerstands)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mantén pulsado** para ampliar o marcar una excepción (p. ej. la foto de un contador)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Maintenez appuyé** pour agrandir ou marquer une exception (p. ex. la photo d’un compteur)."
          }
        }
      }
    },
    "**Slow motion i tryb kinowy** pomijamy, żeby nie zepsuć efektów.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Slow motion and Cinematic** videos are skipped so their effects aren’t lost."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Zeitlupe und Kinomodus** werden übersprungen, damit die Effekte erhalten bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**La cámara lenta y el modo Cine** se omiten para no estropear los efectos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ralenti et mode Cinématique** sont ignorés pour ne pas abîmer les effets."
          }
        }
      }
    },
    "**Stuknij film**, by go obejrzeć. W odtwarzaczu przytrzymaj „Usuń wideo”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tap a video** to watch it. In the player, hold “Delete video”."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tippe auf ein Video**, um es anzusehen. Im Player „Video löschen“ gedrückt halten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toca un vídeo** para verlo. En el reproductor, mantén pulsado «Eliminar vídeo»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touchez une vidéo** pour la regarder. Dans le lecteur, maintenez « Supprimer la vidéo »."
          }
        }
      }
    },
    "**Stuknij** zdjęcie, by zmienić: zostaw albo usuń.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tap** a photo to switch between keep and delete."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tippe** auf ein Foto, um zwischen Behalten und Löschen zu wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toca** una foto para cambiar entre conservar y eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touchez** une photo pour basculer entre conserver et supprimer."
          }
        }
      }
    },
    "**Stuknij**, by przerzucić zdjęcie do drugiej grupy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tap** to move a photo to the other group."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tippe**, um ein Foto in die andere Gruppe zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toca** para pasar una foto al otro grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touchez** pour déplacer une photo dans l’autre groupe."
          }
        }
      }
    },
    "**Stuknij**, by przerzucić zdjęcie między Rozmyte i Ostre.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tap** to move a photo between Blurry and Sharp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tippe**, um ein Foto zwischen Unscharf und Scharf zu verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Toca** para mover una foto entre Borrosas y Nítidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Touchez** pour déplacer une photo entre Floues et Nettes."
          }
        }
      }
    },
    "**Trudno ocenić?** Pomiń zdjęcie.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hard to tell?** Skip the photo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Schwer zu sagen?** Foto überspringen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**¿Difícil de decidir?** Omite la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Difficile à dire ?** Passez la photo."
          }
        }
      }
    },
    "**Twoje decyzje** uczą model. Przed kolejną partią sam się douczy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Your decisions** teach the model. It updates itself before the next batch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Deine Entscheidungen** trainieren das Modell. Vor dem nächsten Stapel lernt es selbst dazu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Tus decisiones** enseñan al modelo. Se actualizará solo antes del siguiente lote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Vos décisions** entraînent le modèle. Il se met à jour tout seul avant le lot suivant."
          }
        }
      }
    },
    "**Uwaga:** celowo rozmyte tło (np. portret) też może tu trafić.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Note:** an intentionally blurred background (e.g. Portrait) may end up here too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hinweis:** Ein absichtlich unscharfer Hintergrund (z. B. Porträt) kann auch hier landen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nota:** un fondo desenfocado a propósito (p. ej. Retrato) también puede aparecer aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Attention :** un arrière-plan flou volontaire (p. ex. Portrait) peut aussi apparaître ici."
          }
        }
      }
    },
    "**Zaznacz** filmy do kompresji (HEVC 1080p). Przy każdym widać szacowaną oszczędność.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Select** videos to compress (HEVC 1080p). Each shows the estimated savings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Wähle** Videos zum Komprimieren aus (HEVC 1080p). Bei jedem siehst du die geschätzte Ersparnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Selecciona** vídeos para comprimir (HEVC 1080p). Cada uno muestra el ahorro estimado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sélectionnez** les vidéos à compresser (HEVC 1080p). Chacune affiche l’économie estimée."
          }
        }
      }
    },
    "Doucz model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Train more"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter trainieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir entrenando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entraîner davantage"
          }
        }
      }
    },
    "Jak to działa": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert es"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo funciona"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment ça marche"
          }
        }
      }
    },
    "Mierzy ostrość każdego zdjęcia i proponuje usunięcie nieostrych.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures the sharpness of every photo and suggests deleting blurry ones."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst die Schärfe jedes Fotos und schlägt vor, unscharfe zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide la nitidez de cada foto y propone eliminar las borrosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure la netteté de chaque photo et propose de supprimer les floues."
          }
        }
      }
    },
    "Model douczy się na tych decyzjach przed kolejną partią.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model will learn from these decisions before the next batch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell lernt vor dem nächsten Stapel aus diesen Entscheidungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo aprenderá de estas decisiones antes del siguiente lote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle apprendra de ces décisions avant le lot suivant."
          }
        }
      }
    },
    "Model nauczony na Twoich decyzjach dzieli zdjęcia na do usunięcia i do zachowania.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model trained on your decisions splits photos into ones to delete and ones to keep."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Modell, das aus deinen Entscheidungen gelernt hat, teilt Fotos in Löschen und Behalten auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modelo entrenado con tus decisiones separa las fotos en eliminar y conservar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle entraîné sur vos décisions répartit les photos entre à supprimer et à conserver."
          }
        }
      }
    },
    "Model wytrenowany": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model trained"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell trainiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo entrenado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle entraîné"
          }
        }
      }
    },
    "Na początku przeglądaj małe partie. Model szybciej nauczy się Twoich wyborów.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with small batches. The model will learn your choices faster."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit kleinen Stapeln. So lernt das Modell deine Auswahl schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con lotes pequeños. El modelo aprenderá tus elecciones más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par de petits lots. Le modèle apprendra vos choix plus vite."
          }
        }
      }
    },
    "Najpierw naucz model": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Train the model first"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trainiere zuerst das Modell"
          }
        },
        "es": {
