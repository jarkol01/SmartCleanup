    "Wyższa wartość oznacza więcej zdjęć w „Przejrzyj niepewne” — model musi być bardziej pewny, żeby coś ominęło ręczną kontrolę.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein höherer Wert bedeutet mehr Fotos in „Unsichere prüfen“ — das Modell muss sicherer sein, damit etwas die manuelle Prüfung überspringt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher value means more photos in \"Review uncertain\" — the model has to be more confident for something to skip manual review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un valor más alto significa más fotos en \"Revisar inciertas\": el modelo debe estar más seguro para que algo se salte la revisión manual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une valeur plus élevée signifie plus de photos dans « Examiner les incertaines » — le modèle doit être plus confiant pour qu'une photo échappe au contrôle manuel."
          }
        }
      }
    },
    "Włącz dostęp do zdjęć w Ustawieniach, aby korzystać z aplikacji.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere den Fotozugriff in den Einstellungen, um die App zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable photo access in Settings to use the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el acceso a las fotos en Ajustes para usar la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez l'accès aux photos dans Réglages pour utiliser l'application."
          }
        }
      }
    },
