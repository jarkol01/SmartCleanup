    "Kliknij \"Zakończ\", żeby wytrenować model.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap \"Finish\" to train the model."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf „Fertig“, um das Modell zu trainieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur « Terminer » pour entraîner le modèle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca \"Finalizar\" para entrenar el modelo."
          }
        }
      }
    },
    "Przeciągnij w prawo, żeby zachować, w lewo, żeby usunąć": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe right to keep, left to delete"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach rechts wischen zum Behalten, nach links zum Löschen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez à droite pour conserver, à gauche pour supprimer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza a la derecha para conservar, a la izquierda para eliminar"
          }
        }
      }
    },
    "Pomiń — trudno ocenić": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
