    "Miejsce zwolni się dopiero po opróżnieniu albumu „Ostatnio usunięte”.": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher wird erst nach dem Leeren von „Zuletzt gelöscht“ frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space is freed only after you empty “Recently Deleted”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio se libera solo tras vaciar «Eliminado»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace n’est libéré qu’après avoir vidé « Supprimés récemment »."
          }
        }
      }
    },
    "Model chce to usunąć. Przeciągnij w prawo, żeby jednak zachować, w lewo, żeby potwierdzić.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell möchte dies löschen. Nach rechts wischen, um es doch zu behalten, nach links zum Bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model wants to delete this. Swipe right to keep it after all, left to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo quiere eliminar esto. Desliza a la derecha para conservarlo de todos modos, a la izquierda para confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle veut supprimer cette photo. Balayez à droite pour la conserver quand même, à gauche pour confirmer."
          }
        }
      }
    },
